#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <11 12>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W     &kp E     &kp R   &kp T                                         &kp Y      &kp U        &kp I       &kp O     &kp P
&kp A      &kp S     &kp D     &kp F   &kp G                                         &kp H      &kp J        &kp K       &kp L     &kp MINUS
&kp Z      &kp X     &kp C     &kp V   &kp B                                         &kp N      &kp M        &kp COMMA   &kp DOT   &mo 3
           &kp LGUI  &kp LALT  &mo 2   &kp LCTRL   &mt LSFT SPACE           &kp RET  &kp BSPC                            &none
            >;
        };


        layer_1 {
            bindings = <
&kp CARET      &kp NUMBER_7   &kp NUMBER_8   &kp NUMBER_9   &kp AT_SIGN                              &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp DOUBLE_QUOTES      &kp SEMI    &kp EXCLAMATION
&kp PLUS       &kp NUMBER_4   &kp NUMBER_5   &kp NUMBER_6   &kp HASH                                 &kp LEFT_BRACKET        &kp RIGHT_BRACKET      &kp SINGLE_QUOTE       &kp COLON   &kp QMARK
&kp ASTERISK   &kp NUMBER_1   &kp NUMBER_2   &kp NUMBER_3   &kp UNDERSCORE                           &kp SLASH               &kp BACKSLASH          &kp AMPERSAND          &kp PIPE    &kp PERCENT
               &kp NUMBER_0   &kp DOT        &kp COMMA      &trans          &trans          &kp RET  &kp BSPC                                                              &kp DOLLAR
            >;
        };


        MOUSE {
            bindings = <
&trans   &kp F7   &kp F8   &kp F9   &kp F10                         &trans   &trans           &trans           &trans            &trans
&trans   &kp F4   &kp F5   &kp F6   &kp F11                         &trans   &trans           &kp UP_ARROW     &trans            &trans
&trans   &kp F1   &kp F2   &kp F3   &kp F12                         &trans   &kp LEFT_ARROW   &kp DOWN_ARROW   &kp RIGHT_ARROW   &trans
         &trans   &trans   &trans   &trans    &trans      &kp RET   &kp BSPC                                   &kp ESC
            >;
        };


        SCROLL {
            bindings = <
&bt BT_CLR       &trans         &trans         &trans         &trans                                &trans     &trans   &trans   &trans   &trans
&bt BT_CLR_ALL   &bt BT_SEL 4   &trans         &trans         &trans                                &trans     &trans   &trans   &trans   &trans
&trans           &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &trans                                &mkp MB5   &trans   &trans   &trans   &trans
                 &bt BT_SEL 0   &trans         &trans         &trans   &trans      &studio_unlock   &mkp MB4                     &trans
            >;
        };


        layer_4 {
            bindings = <
&trans   &trans         &trans         &trans         &trans                                &trans   &trans   &trans   &trans   &trans
&trans   &bt BT_SEL 4   &trans         &trans         &trans                                &trans   &trans   &trans   &trans   &trans
&trans   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &trans                                &trans   &trans   &trans   &trans   &trans
         &bt BT_SEL 0   &trans         &trans         &trans   &trans      &studio_unlock   &trans                     &trans
            >;
        };


        layer_5 {
            bindings = <
&trans   &trans   &trans   &trans   &trans                                &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans                                &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans                                &trans   &trans   &trans   &trans   &trans
         &trans   &trans   &trans   &trans   &trans      &studio_unlock   &trans                     &trans
            >;
        };


        layer_6 {
            bindings = <
&bt BT_CLR       &trans         &trans         &trans         &trans                                &trans   &trans   &trans   &trans   &trans
&bt BT_CLR_ALL   &trans         &trans         &trans         &trans                                &trans   &trans   &trans   &trans   &trans
&trans           &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &trans                                &trans   &trans   &trans   &trans   &trans
                 &bt BT_SEL 0   &trans         &trans         &trans   &trans      &studio_unlock   &trans                     &trans
            >;
        };
    };
};